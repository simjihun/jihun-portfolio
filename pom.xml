<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.4</version>
        <relativePath/>
    </parent>

    <groupId>com.jihun</groupId>
    <artifactId>jihun-portfolio</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>JihunPortfolio</name>
    <description>개인 프로젝트 포트폴리오 - 기능별 모듈을 확장해가는 Spring Boot 애플리케이션</description>

    <properties>
        <java.version>21</java.version>
        <aws-sdk.version>2.51.4</aws-sdk.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- AWS SDK v2 BOM — 관리자 대시보드의 Free Tier·Cost Explorer·Billing Credits 조회용 -->
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws-sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- 웹(REST API + 정적 페이지) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- DB 접근(JPA) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- 요청값 검증 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- 인증/인가 (비공개 회원 영역: 회원가입·로그인·관리자 승인) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- 이메일 발송 (비밀번호 재설정 인증번호) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- RSS 파싱 (뉴스 수집용) -->
        <dependency>
            <groupId>com.rometools</groupId>
            <artifactId>rome</artifactId>
            <version>2.1.0</version>
        </dependency>

        <!-- HTML 파싱 (기사 OpenGraph 미리보기용) -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>1.18.3</version>
        </dependency>

        <!-- 인메모리 DB (로컬 개발용, 기본 프로파일) -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- MySQL 드라이버 (운영 프로파일: AWS RDS 연동용) -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 관리자 대시보드: AWS 프리티어 사용량 조회(무료 API) -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>freetier</artifactId>
        </dependency>

        <!-- 관리자 대시보드: 일별 비용 조회(호출당 소액 과금, 서버에서 캐시해 호출량 최소화) -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>costexplorer</artifactId>
        </dependency>

        <!-- 관리자 대시보드: 계정 크레딧 잔액·소진 예상일 조회(2026-07 공개된 billing:GetCredits) -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>billing</artifactId>
        </dependency>

        <!-- 관리자 대시보드: GetCredits 호출에 필요한 12자리 계정ID를 자동으로 조회(읽기 전용) -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>sts</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
